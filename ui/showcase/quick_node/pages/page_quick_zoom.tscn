theme_override_font_sizes/font_size = 14
text = "任意 Control 挂上 QuickZoom 即可从当前缩放播放到目标端点（只动 scale/pivot，布局与可见性全程不变）；入场宿主持展开端点、离场宿主持收起端点，target_scale 按分量（x=宽 y=高）——「高 0↔1」竖向展开、「宽 0↔1」横向展开、「强调」不消失脉冲；顶部悬停强调由页面轮询触发两个宿主（触发归调用方）。"
autowrap_mode = 3

